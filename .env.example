# Copy this file to `.env` and fill in cookies from your own logged-in
# LinkedIn browser session. Never commit the real `.env` to version control.
#
# These are session secrets: anyone holding LINKEDIN_LI_AT can act as your
# LinkedIn account. Treat them exactly like a password.
#
# How to obtain them (Chrome/Edge: DevTools > Application > Cookies >
# https://www.linkedin.com; Firefox: DevTools > Storage > Cookies):
#
#   li_at       long-lived member session token
#   JSESSIONID  doubles as the CSRF token; value looks like "ajax:1234567890"
#               (the surrounding double quotes may be included or omitted —
#                both are accepted)
#
# A username/password login is deliberately NOT supported: the session
# LinkedIn issues to that flow is revoked within seconds. See README,
# "Authentication".

LINKEDIN_LI_AT=paste-your-li_at-cookie-value-here
LINKEDIN_JSESSIONID="ajax:0000000000000000000"
